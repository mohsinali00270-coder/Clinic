# Copy to .env and fill in. Never commit .env.
SQL_SA_PASSWORD=
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SIGNING_KEY=
# First start only: create the Super Admin, then set back to false.
SEED_ENABLED=false
SUPERADMIN_PASSWORD=
CHANGELOG_RETENTION_DAYS=90
# Optional OpenTelemetry collector, e.g. http://otel-collector:4317
OTLP_ENDPOINT=
