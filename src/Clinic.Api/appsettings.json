{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Clinic": "Server=(localdb)\\MSSQLLocalDB;Database=ClinicDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "Provider": "SqlServer"
  },
  "Jwt": {
    "Issuer": "clinic-api",
    "Audience": "clinic-staff",
    "SigningKey": ""
  },
  "Auth": {
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30,
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Seed": {
    "Enabled": false
  }
}
