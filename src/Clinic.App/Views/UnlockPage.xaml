<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.UnlockPage"
             x:DataType="vm:UnlockViewModel"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Title="Unlock">
    <Grid Background="{AppThemeBinding Light={StaticResource HeroGradient}, Dark={StaticResource HeroGradientDark}}">
        <ScrollView>
            <Grid Padding="20,32" RowDefinitions="*,Auto,*">
                <Border Grid.Row="1" Style="{StaticResource ElevatedCard}" Padding="28,26" MaximumWidthRequest="400"
                        StrokeShape="RoundRectangle 22" Stroke="Transparent">
                    <VerticalStackLayout Spacing="8">
                        <Image Source="brand_mark.png" WidthRequest="52" HeightRequest="52" HorizontalOptions="Center"
                               SemanticProperties.Description="Clinic logo" />
                        <Label Text="Unlock" Style="{StaticResource PageTitle}" FontSize="22" HorizontalOptions="Center" />
                        <Label Text="{Binding Greeting}" Style="{StaticResource Muted}" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                        <Entry Text="{Binding Pin}" IsPassword="True" Keyboard="Numeric" MaxLength="8" Placeholder="PIN"
                               HorizontalTextAlignment="Center" FontSize="24" CharacterSpacing="6" ReturnCommand="{Binding UnlockCommand}"
                               SemanticProperties.Description="Offline PIN" Margin="0,12,0,0" MinimumHeightRequest="54" />
                        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Unlock" Command="{Binding UnlockCommand}" MinimumHeightRequest="48" Margin="0,8,0,0" />
                        <Button Text="Sign in with password instead" Command="{Binding UsePasswordCommand}"
                                Style="{StaticResource LinkButton}" FontSize="13" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
