<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.UnlockPage"
             x:DataType="vm:UnlockViewModel"
             Shell.NavBarIsVisible="False"
             Shell.FlyoutBehavior="Disabled"
             Title="Unlock">
    <ScrollView>
        <Grid Padding="24" RowDefinitions="*,Auto,*">
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="28" MaximumWidthRequest="400">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Unlock" Style="{StaticResource PageTitle}" HorizontalOptions="Center" />
                    <Label Text="{Binding Greeting}" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                    <Entry Text="{Binding Pin}" IsPassword="True" Keyboard="Numeric" MaxLength="8" Placeholder="PIN"
                           HorizontalTextAlignment="Center" FontSize="22" ReturnCommand="{Binding UnlockCommand}"
                           SemanticProperties.Description="Offline PIN" Margin="0,12,0,0" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" HorizontalOptions="Center" />
                    <Button Text="Unlock" Command="{Binding UnlockCommand}" MinimumHeightRequest="44" Margin="0,8,0,0" />
                    <Button Text="Sign in with password instead" Command="{Binding UsePasswordCommand}"
                            Style="{StaticResource SecondaryButton}" BorderWidth="0" FontSize="13" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </ScrollView>
</ContentPage>
