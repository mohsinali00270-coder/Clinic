<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.LabWorkPage"
             x:DataType="vm:LabWorkViewModel"
             Title="Lab">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <CollectionView ItemsSource="{Binding Items}" Margin="20,12" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="6" Padding="0,0,0,8">
                    <Label Text="Lab work list" Style="{StaticResource PageTitle}" />
                    <Picker ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" SemanticProperties.Description="Which tests to show" />
                    <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
                </VerticalStackLayout>
            </CollectionView.Header>
            <CollectionView.EmptyView>
                <Label Text="Nothing here." Style="{StaticResource Muted}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:CareRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LabWorkViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" TextColor="{Binding TitleColor}" />
                            <Label Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>
</ContentPage>
