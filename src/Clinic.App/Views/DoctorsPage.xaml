<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.DoctorsPage"
             x:DataType="vm:DoctorsViewModel"
             Title="Doctors">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add doctor" Command="{Binding AddCommand}" />
        <ToolbarItem Text="Types &amp; holidays" Command="{Binding SetupCommand}" />
    </ContentPage.ToolbarItems>
    <Grid RowDefinitions="Auto,*" Padding="20,12" MaximumWidthRequest="860">
        <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
        <CollectionView Grid.Row="1" ItemsSource="{Binding Doctors}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="No doctors yet." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,40" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DoctorRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="14,10">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DoctorsViewModel}}, Path=OpenCommand}" CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding Doctor.FullName}" FontSize="16" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding Subtitle}" Style="{StaticResource Muted}" />
                            <Label Text="{Binding Licence}" TextColor="{StaticResource Warning}" FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
