<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.StockPage"
             x:DataType="vm:StockViewModel"
             Title="Pharmacy stock">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,12" Spacing="10" MaximumWidthRequest="900">
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <Entry Text="{Binding Search}" Placeholder="Search items" />
                    <Label Grid.Column="1" Text="Alerts only" VerticalOptions="Center" />
                    <Switch Grid.Column="2" IsToggled="{Binding OnlyAlerts}" />
                    <Button Grid.Column="3" Text="Receive stock" Command="{Binding ReceiveCommand}" IsVisible="{Binding CanReceive}" />
                </Grid>
                <Label Text="Alerts" Style="{StaticResource FieldLabel}" FontSize="15" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Alerts}" Spacing="4">
                    <BindableLayout.EmptyView><Label Text="Nothing here." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CareRow">
                            <VerticalStackLayout Padding="10,6" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Detail}" TextColor="{Binding TitleColor}" FontSize="12" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                <Label Text="Items (tap for count, write-off, transfer)" Style="{StaticResource FieldLabel}" FontSize="15" Margin="0,8,0,0" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Items}" Spacing="4">
                    <BindableLayout.EmptyView><Label Text="Nothing here." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CareRow">
                            <VerticalStackLayout Padding="10,6" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">
                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:StockViewModel}}, Path=ItemActionCommand}" CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>
                                <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Detail}" TextColor="{Binding TitleColor}" FontSize="12" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
