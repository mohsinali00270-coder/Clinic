<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.BranchEditPage"
             x:DataType="vm:BranchEditViewModel"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="4" MaximumWidthRequest="640">
            <Label Text="Code" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Code}" Placeholder="Short code used in record numbers, e.g. MAIN" MaxLength="10" />

            <Label Text="Name" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Name}" Placeholder="Branch name" />

            <Label Text="Address" Style="{StaticResource FieldLabel}" />
            <Editor Text="{Binding Address}" Placeholder="Address" AutoSize="TextChanges" />

            <Label Text="Phone" Style="{StaticResource FieldLabel}" />
            <Entry Text="{Binding Phone}" Keyboard="Telephone" Placeholder="Phone" />

            <HorizontalStackLayout Spacing="8" Margin="0,8,0,0">
                <Switch IsToggled="{Binding IsActive}" />
                <Label Text="Active" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" Margin="0,8" />

            <HorizontalStackLayout Spacing="10" Margin="0,16,0,0">
                <Button Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsNotBusy}" MinimumWidthRequest="120" />
                <Button Text="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
