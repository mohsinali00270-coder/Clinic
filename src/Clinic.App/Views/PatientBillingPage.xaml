<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.PatientBillingPage"
             x:DataType="vm:PatientBillingViewModel"
             Title="Billing">
    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="10" MaximumWidthRequest="900">
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding PatientName}" Style="{StaticResource PageTitle}" FontSize="20" />
                    <Label Text="{Binding BalanceText}" FontFamily="OpenSansSemibold" />
                    <Button Text="Advance deposit" Command="{Binding DepositCommand}" Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />

            <!-- FR-BIL-02: what was done and is not billed yet -->
            <Label Text="Not billed yet" Style="{StaticResource FieldLabel}" FontSize="15" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Unbilled}" Spacing="2">
                <BindableLayout.EmptyView><Label Text="Everything is billed." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChargeRow">
                        <HorizontalStackLayout Spacing="6">
                            <CheckBox IsChecked="{Binding Selected}" />
                            <Label Text="{Binding Text}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
            <Button Text="New invoice" Command="{Binding CreateInvoiceCommand}" HorizontalOptions="Start" />

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="Packages" Style="{StaticResource FieldLabel}" FontSize="15" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Sell package" Command="{Binding SellPackageCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Packages}" Spacing="2">
                <BindableLayout.EmptyView><Label Text="No packages." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CareRow">
                        <VerticalStackLayout Padding="10,4">
                            <Label Text="{Binding Title}" TextColor="{Binding TitleColor}" />
                            <Label Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <Label Text="Panels and insurance" Style="{StaticResource FieldLabel}" FontSize="15" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="Add panel" Command="{Binding AddPanelCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Panels}" Spacing="2">
                <BindableLayout.EmptyView><Label Text="Self-paying." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CareRow">
                        <VerticalStackLayout Padding="10,4">
                            <Label Text="{Binding Title}" />
                            <Label Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="12" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Invoices" Style="{StaticResource FieldLabel}" FontSize="15" Margin="0,8,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Invoices}" Spacing="4">
                <BindableLayout.EmptyView><Label Text="No invoices." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:CareRow">
                        <VerticalStackLayout Padding="10,6" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:PatientBillingViewModel}}, Path=OpenInvoiceCommand}" CommandParameter="{Binding .}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding Title}" FontFamily="OpenSansSemibold" />
                            <Label Text="{Binding Detail}" TextColor="{Binding TitleColor}" FontSize="12" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
