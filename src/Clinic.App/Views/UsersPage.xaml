<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.UsersPage"
             x:DataType="vm:UsersViewModel"
             Title="Users">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Add user" Command="{Binding AddCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,12" RowSpacing="8" MaximumWidthRequest="760">
        <SearchBar Text="{Binding Search}" Placeholder="Search name, user name or phone" SearchCommand="{Binding LoadCommand}" />
        <Label Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Muted}" />
        <Label Grid.Row="2" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />

        <RefreshView Grid.Row="3" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Users}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="No users found." Style="{StaticResource Muted}" HorizontalOptions="Center" Margin="0,40" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:UserRow">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:UsersViewModel}}, Path=EditCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                                <Border WidthRequest="44" HeightRequest="44" StrokeShape="RoundRectangle 22" StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}">
                                    <Label Text="{Binding Initials}" HorizontalOptions="Center" VerticalOptions="Center" FontFamily="OpenSansSemibold" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                    <Label Text="{Binding User.FullName}" FontSize="16" FontFamily="OpenSansSemibold" />
                                    <Label Text="{Binding User.UserName, StringFormat='@{0}'}" Style="{StaticResource Muted}" />
                                    <Label Text="{Binding RolesText}" FontSize="13" />
                                    <Label Text="{Binding BranchesText}" Style="{StaticResource Muted}" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2" Style="{StaticResource Badge}">
                                    <Label Text="{Binding StatusText}" FontSize="12" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
