<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             xmlns:local="clr-namespace:Clinic.Client.Core.Local;assembly=Clinic.Client.Core"
             x:Class="Clinic.App.Views.NotesPage"
             x:DataType="vm:NotesViewModel"
             Title="Handover notes">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New note" Command="{Binding AddCommand}" />
        <ToolbarItem Text="Sync now" Command="{Binding SyncNowCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Padding="20,12" RowSpacing="8" MaximumWidthRequest="760">
        <Label Text="{Binding Sync.StatusText}" Style="{StaticResource Muted}" />

        <Picker Grid.Row="1" Title="Branch" ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}"
                ItemDisplayBinding="{Binding Name, x:DataType=local:LocalBranch}" />

        <Label Grid.Row="2" Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />

        <CollectionView Grid.Row="3" ItemsSource="{Binding Notes}" SelectionMode="None">
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" Margin="0,40" Spacing="6">
                    <Label Text="No notes for this branch yet." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                    <Label Text="Notes are saved on this device first and sync when online." Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:NoteRow">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=EditCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="6,*,Auto">
                            <BoxView Color="{Binding Accent}" />
                            <VerticalStackLayout Grid.Column="1" Padding="14,12" Spacing="4">
                                <Label Text="{Binding Title}" FontSize="16" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding Body}" MaxLines="4" LineBreakMode="TailTruncation" />
                                <Label Text="{Binding When}" Style="{StaticResource Muted}" />
                                <Label Text="{Binding SyncText}" IsVisible="{Binding HasSyncText}" TextColor="{StaticResource Warning}" FontSize="12" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2" Text="Pin" Style="{StaticResource SecondaryButton}" BorderWidth="0" VerticalOptions="Start" Margin="0,6,6,0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NotesViewModel}}, Path=TogglePinCommand}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
