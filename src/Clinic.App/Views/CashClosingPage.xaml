<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             x:Class="Clinic.App.Views.CashClosingPage"
             x:DataType="vm:CashClosingViewModel"
             Title="Cash closing">
    <RefreshView Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
        <ScrollView>
            <VerticalStackLayout Padding="20,12" Spacing="10" MaximumWidthRequest="700">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="Day" VerticalOptions="Center" />
                    <DatePicker Date="{Binding Date}" Format="ddd dd MMM yyyy" />
                </HorizontalStackLayout>
                <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding MySummary}" FontFamily="OpenSansSemibold" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding MyMethods}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String"><Label Text="{Binding .}" FontSize="13" /></DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{Binding BranchSummary}" Style="{StaticResource Muted}" Margin="0,6,0,0" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Cash counted in the drawer (Rs)" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Counted}" Keyboard="Numeric" />
                        <Label Text="Notes" Style="{StaticResource FieldLabel}" />
                        <Entry Text="{Binding Notes}" Placeholder="e.g. Rs 10 short, change given" />
                        <Button Text="Close my cash" Command="{Binding CloseCommand}" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="My recent closings" Style="{StaticResource FieldLabel}" FontSize="15" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Closings}" Spacing="4">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CareRow">
                            <VerticalStackLayout Padding="10,4">
                                <Label Text="{Binding Title}" />
                                <Label Text="{Binding Detail}" TextColor="{Binding TitleColor}" FontSize="12" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
