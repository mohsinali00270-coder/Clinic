<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Clinic.App.ViewModels"
             xmlns:s="clr-namespace:Clinic.Shared.Scheduling;assembly=Clinic.Shared"
             x:Class="Clinic.App.Views.SchedulingSetupPage"
             x:DataType="vm:SchedulingSetupViewModel"
             Title="Types &amp; holidays">
    <ScrollView>
        <VerticalStackLayout Padding="20,12" Spacing="10" MaximumWidthRequest="860">
            <Label Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Style="{StaticResource ErrorLabel}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Appointment types" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+ Add type" Command="{Binding AddTypeCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Types}" Spacing="4">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="s:AppointmentTypeDto">
                        <Border Style="{StaticResource Card}" Padding="12,8">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SchedulingSetupViewModel}}, Path=EditTypeCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                <Label Text="{Binding DurationMinutes, StringFormat='{0} min'}" Style="{StaticResource Muted}" />
                                <Label Text="{Binding PreparationInstructions}" Style="{StaticResource Muted}" FontSize="12" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <Label Text="Branch holidays and closures" FontFamily="OpenSansSemibold" FontSize="16" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="+ Add holiday" Command="{Binding AddClosureCommand}" Style="{StaticResource SecondaryButton}" />
            </Grid>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Closures}" Spacing="4">
                <BindableLayout.EmptyView><Label Text="No upcoming holidays." Style="{StaticResource Muted}" /></BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ClosureRow">
                        <Grid ColumnDefinitions="*,Auto" Padding="10,4" BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray950}}">
                            <Label Text="{Binding Text}" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="Remove" Style="{StaticResource DangerButton}" BorderWidth="0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SchedulingSetupViewModel}}, Path=RemoveClosureCommand}" CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
