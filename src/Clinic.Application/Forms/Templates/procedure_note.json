    { "key": "complication_details", "type": "multilineText", "label": { "en": "Complication details" }, "visibleWhen": "complications == true",
      "requiredWhen": "complications == true", "columns": 3 },
    { "key": "pain_score", "type": "integer", "label": { "en": "Pain after (0–10)" }, "min": 0, "max": 10, "columns": 1 },
    { "key": "aftercare", "type": "multilineText", "label": { "en": "Aftercare advice", "ur": "بعد کی ہدایات" }, "columns": 4, "printOnPrescription": true }
  ] } ] } }
