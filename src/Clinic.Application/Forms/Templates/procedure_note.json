  "sections": [ { "key": "note", "title": { "en": "Procedure", "ur": "طریقۂ علاج" }, "fields": [
    { "key": "indication", "type": "text", "label": { "en": "Indication", "ur": "وجہ" }, "required": true, "columns": 4 },
    { "key": "site", "type": "text", "label": { "en": "Site / tooth / area" }, "columns": 2 },
    { "key": "anaesthesia", "type": "singleSelect", "label": { "en": "Anaesthesia" }, "columns": 2,
      "options": [ { "code": "none", "label": { "en": "None" } }, { "code": "local", "label": { "en": "Local" } },
                   { "code": "topical", "label": { "en": "Topical" } }, { "code": "sedation", "label": { "en": "Sedation" } } ] },
    { "key": "findings", "type": "multilineText", "label": { "en": "Findings and technique" }, "columns": 4 },
