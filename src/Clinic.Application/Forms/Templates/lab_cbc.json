{ "key": "lab_cbc", "name": "Lab: complete blood count", "entityType": "LabResult",
  "description": "CBC parameters with adult reference ranges (Hb by gender). Publish with context 'cbc'.",
  "definition": { "entityType": "LabResult", "name": { "en": "Complete blood count", "ur": "خون کا مکمل ٹیسٹ" },
  "sections": [ { "key": "cbc", "title": { "en": "Results" }, "fields": [
    { "key": "hb", "type": "decimal", "label": { "en": "Haemoglobin" }, "unit": "g/dL", "decimals": 1, "min": 1, "max": 25, "required": true, "columns": 1,
      "help": { "en": "Ref: M 13.0–17.5 · F 12.0–15.5" },
      "abnormal": [ { "when": "value < 7", "severity": "critical", "message": { "en": "Severe anaemia" } },
                    { "when": "(gender == 'F' && value < 12) || (gender != 'F' && value < 13)", "severity": "warning", "message": { "en": "Low" } },
                    { "when": "(gender == 'F' && value > 15.5) || (gender != 'F' && value > 17.5)", "severity": "warning", "message": { "en": "High" } } ] },
    { "key": "wbc", "type": "decimal", "label": { "en": "Total leucocyte count" }, "unit": "×10⁹/L", "decimals": 1, "min": 0, "max": 200, "required": true, "columns": 1,
      "help": { "en": "Ref: 4.0–11.0" },
      "abnormal": [ { "when": "value < 4", "severity": "warning", "message": { "en": "Low" } }, { "when": "value > 11", "severity": "warning", "message": { "en": "High" } },
                    { "when": "value > 30", "severity": "critical", "message": { "en": "Very high" } } ] },
    { "key": "platelets", "type": "integer", "label": { "en": "Platelets" }, "unit": "×10⁹/L", "min": 0, "max": 2000, "required": true, "columns": 1,
      "help": { "en": "Ref: 150–450" },
      "abnormal": [ { "when": "value < 50", "severity": "critical", "message": { "en": "Very low" } }, { "when": "value < 150", "severity": "warning", "message": { "en": "Low" } },
                    { "when": "value > 450", "severity": "warning", "message": { "en": "High" } } ] },
    { "key": "mcv", "type": "decimal", "label": { "en": "MCV" }, "unit": "fL", "decimals": 1, "min": 40, "max": 150, "columns": 1, "help": { "en": "Ref: 80–100" },
      "abnormal": [ { "when": "value < 80", "severity": "warning", "message": { "en": "Microcytic" } }, { "when": "value > 100", "severity": "warning", "message": { "en": "Macrocytic" } } ] },
    { "key": "neutrophils", "type": "integer", "label": { "en": "Neutrophils" }, "unit": "%", "min": 0, "max": 100, "columns": 1, "help": { "en": "Ref: 40–75" } },
    { "key": "lymphocytes", "type": "integer", "label": { "en": "Lymphocytes" }, "unit": "%", "min": 0, "max": 100, "columns": 1, "help": { "en": "Ref: 20–45" } }
  ] } ] } }
